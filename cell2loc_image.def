bootstrap: docker
from: tensorflow/tensorflow:latest-gpu

%files
    cell2loc_env.yml /root/cell2loc_env.yml
    
%post
    apt-get update && apt-get install -y git wget && rm -rf /var/lib/apt/lists/*
   
    curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -C /usr/local -xvj bin/micromamba
    export MAMBA_ROOT_PREFIX=/usr/local/micromamba  # optional, defaults to ~/micromamba
    export MAMBA_EXE='/usr/local/bin/micromamba'
    eval "$(/usr/local/bin/micromamba shell hook -s posix)"
    /usr/local/bin/micromamba shell init -s bash -r /usr/local/micromamba  # this writes to your .bashrc file
    /usr/local/bin/micromamba shell hook --shell bash --root-prefix "$MAMBA_ROOT_PREFIX"
    micromamba install -n base --file /root/cell2loc_env.yml 
    micromamba clean --all --yes 
    which python
    #pip3 install ipykernel
    #pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118

    #pip3 install scvi-tools==1.1.2

    #pip install git+https://github.com/BayraktarLab/cell2location.git#egg=cell2location[tutorials,dev]
    #python -m ipykernel install --user --name=cell2location_cuda118_torch22 --display-name='Environment (cell2location_cuda118_torch22)'

    #pip install celltypist

%environment
    # Ensure conda is in the PATH at runtime
    export PATH="/usr/local/miniconda3/bin:$PATH"
    export MAMBA_ROOT_PREFIX=/usr/local/micromamba  # optional, defaults to ~/micromamba
    export MAMBA_EXE='/usr/local/bin/micromamba'
    
%runscript 
    micromamba run -n base python $@